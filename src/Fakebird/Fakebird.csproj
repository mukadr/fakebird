<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Fakebird</RootNamespace>
    <TieredPGO>true</TieredPGO>
    <InvariantGlobalization>false</InvariantGlobalization>
    <NoWarn>$(NoWarn);CS8618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Fakebird.Tests" />
    <InternalsVisibleTo Include="Fakebird.Bench" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Types\TimeZoneData.bin" LogicalName="Fakebird.Types.TimeZoneData.bin" />
  </ItemGroup>

</Project>
